{
	"info": {
		"_postman_id": "YOUR_UNIQUE_COLLECTION_ID",
		"name": "MyrentAbuja Backend API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_collection_link": "https://www.postman.com/collections/YOUR_UNIQUE_COLLECTION_ID"
	},
	"variables": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "landlordToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "tenantToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "propertyId",
			"value": "",
			"type": "string"
		},
		{
			"key": "landlordUserId",
			"value": "",
			"type": "string"
		},
		{
			"key": "tenantUserId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "User Registration (Tenant)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"role\": \"tenant\",\n    \"name\": \"Postman Tenant\",\n    \"dateOfBirth\": \"1997-03-15\",\n    \"email\": \"postmantenant@example.com\",\n    \"password\": \"postmanpass\",\n    \"phone\": \"08011112222\",\n    \"maritalStatus\": \"Single\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/signup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"signup"
							]
						}
					},
					"response": []
				},
				{
					"name": "User Login (Admin/Landlord)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"adminToken\", jsonData.token);",
									"pm.collectionVariables.set(\"landlordToken\", jsonData.token); // Admin is a landlord for now",
									"pm.collectionVariables.set(\"adminUserId\", jsonData.user.id);",
									"pm.collectionVariables.set(\"landlordUserId\", jsonData.user.id);",
									"console.log(\"Admin/Landlord Token set: \" + pm.collectionVariables.get(\"adminToken\"));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@myrent.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "User Login (Tenant)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"tenantToken\", jsonData.token);",
									"pm.collectionVariables.set(\"tenantUserId\", jsonData.user.id);",
									"console.log(\"Tenant Token set: \" + pm.collectionVariables.get(\"tenantToken\"));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"postmantenant@example.com\",\n    \"password\": \"postmanpass\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Properties",
			"item": [
				{
					"name": "Create Property Listing (Landlord)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"propertyId\", jsonData.id);",
									"console.log(\"Property ID set: \" + pm.collectionVariables.get(\"propertyId\"));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Spacious 3-Bedroom Apartment\",\n    \"description\": \"A beautiful apartment in a serene environment with modern amenities.\",\n    \"location\": \"Wuse 2, Abuja\",\n    \"price\": 350000,\n    \"leaseDurationMonths\": 12,\n    \"ownershipCertificateToken\": \"OWNERSHIP_ABC123\",\n    \"images\": [\n        \"https://placehold.co/600x400/000000/FFFFFF?text=Property+Image+1\",\n        \"https://placehold.co/600x400/000000/FFFFFF?text=Property+Image+2\"\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/properties",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"properties"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get All Properties (Landlord's Owned)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"properties"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Property Details (Authenticated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tenantToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties/{{propertyId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"properties",
								"{{propertyId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Search Properties (Tenant)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tenantToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties/search?location=Wuse%202&minPrice=300000",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"properties",
								"search"
							],
							"query": [
								{
									"key": "location",
									"value": "Wuse 2"
								},
								{
									"key": "minPrice",
									"value": "300000"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Property Status (Landlord)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isOccupied\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/properties/{{propertyId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"properties",
								"{{propertyId}}",
								"status"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Messages",
			"item": [
				{
					"name": "Send Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"recipientId\": {{tenantUserId}},\n    \"propertyId\": {{propertyId}},\n    \"message\": \"Hello tenant, I am the landlord of this property. Are you interested in a viewing?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Messages (as Landlord)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{landlordToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/messages?propertyId={{propertyId}}&participantId={{tenantUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							],
							"query": [
								{
									"key": "propertyId",
									"value": "{{propertyId}}"
								},
								{
									"key": "participantId",
									"value": "{{tenantUserId}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Messages (as Tenant)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tenantToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/messages?propertyId={{propertyId}}&participantId={{landlordUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"messages"
							],
							"query": [
								{
									"key": "propertyId",
									"value": "{{propertyId}}"
								},
								{
									"key": "participantId",
									"value": "{{landlordUserId}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Features",
			"item": [
				{
					"name": "Admin: Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"users"
							]
						}
					},
					"response": []
				},
				{
					"name": "Admin: Verify Property Listing",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"verified\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/properties/{{propertyId}}/verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"properties",
								"{{propertyId}}",
								"verify"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}